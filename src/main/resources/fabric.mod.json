{
  "schemaVersion": 1,
  "id": "sanitymod",
  "version": "${version}",
  "name": "Sanity Mod",
  "description": "A horror mod focusing on sanity.",
  "authors": [
    "Author"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/sanitymod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.sanitymod.SanityMod"
    ],
    "client": [
      "com.sanitymod.SanityModClient"
    ]
  },
  "mixins": [
    "sanitymod.mixins.json",
    {
      "config": "sanitymod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.14.22",
    "fabric": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  }
}
